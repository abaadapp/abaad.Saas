APP_NAME="Abad POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily لا single: ملفٌّ واحدٌ لا يُدوَّر يبتلع القرص بلا سقف — بلغ على
# الإنتاج ٢١٣ ميغابايت، ٤٩٬٨٦٤ سطرًا منها لعطبٍ واحد تكرّر ثلاثة أيام.
# وقراءةُ ملفٍّ بهذا الحجم تعني أنّ أحدًا لا يقرؤه.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------ الحذف النهائيّ للشركات (مغلقٌ افتراضيًّا) ------------------
# فعلٌ لا تراجعَ فيه: يمحو شركةً وكلَّ بياناتها ومستخدميها وملفّاتها. ولا
# يعمل حتّى تُفتح هذه المفاتيحُ صراحةً — وفتحُها قرارٌ لا خطوةُ نشر.
#
# ولا يبدأ الحذفُ إلّا بثلاثٍ معًا: المفتاحُ مفتوح، وقرصٌ مستقلٌّ عن هذا
# الخادم مهيَّأٌ ويُكتب عليه، وعاملُ طابورٍ يعمل. وما عدا ذلك يُردّ بكلمةٍ
# تُقرأ على الشاشة — ولا يُكتفى بالقرص المحلّيّ في صمت.
BUSINESS_PURGE_ENABLED=false

# مفتاحُ تشفير الأرشيف — ٣٢ بايتًا بـbase64، يُولَّد مرّةً:
#     php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# ويُحفظ نسخةٌ منه خارجَ الخادم وخارجَ المستودع: ضياعُه يعني أرشيفًا لا يُفكّ.
BUSINESS_PURGE_ARCHIVE_KEY=

# اسمُ القرص المستقلّ من config/filesystems.php — `spaces` للمهيَّأ هنا
BUSINESS_PURGE_OFFSITE_DISK=
BUSINESS_PURGE_OFFSITE_PREFIX=business-purges

# DigitalOcean Spaces — دلوٌ خاصٌّ لا عامّ، ومفتاحٌ لا يقرأ غيرَه إن أمكن
BUSINESS_PURGE_SPACES_KEY=
BUSINESS_PURGE_SPACES_SECRET=
BUSINESS_PURGE_SPACES_REGION=fra1
BUSINESS_PURGE_SPACES_BUCKET=
BUSINESS_PURGE_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# اتركه فارغًا: يُكشف عاملُ الطابور بـpgrep. ولا يُضبط إلّا على خادمٍ مُنع
# فيه shell_exec ويُعلم أنّ عاملَه يعمل.
# BUSINESS_PURGE_ASSUME_WORKER=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد — بلا هذا لا استعادةَ لحساب.
#
# المُرسِل resend لا smtp: منافذ SMTP الصادرة (587 و465) محجوبة على خادم
# DigitalOcean، فالاتصال يعلّق حتى تنتهي مهلة nginx ولا يصل شيء. وResend
# يرسل عبر HTTPS على 443 وهو لا يُحجب.
#
# RESEND_API_KEY سرٌّ: يُكتب في ملفّ الخادم وحده ولا يُرفع هنا أبدًا.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@abaadapp.om
MAIL_FROM_NAME="أبعاد"

# إعدادات SMTP باقيةٌ لمن يشغّل المشروع على خادمٍ لا يحجب المنفذ:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME هو ما يقرؤه لارافيل في هذه النسخة، و MAIL_ENCRYPTION مفتاحٌ ميت
# لا يقرؤه شيء — والمنفذ 587 يتفاوض على STARTTLS من نفسه.
# MAIL_SCHEME=smtp

# استعادة الحساب — أرقامٌ تُضبط ولا تُكتب في الكود
PASSWORD_RECOVERY_OTP_TTL=600
PASSWORD_RECOVERY_OTP_MAX_ATTEMPTS=5
PASSWORD_RECOVERY_RESEND_COOLDOWN=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# بيانات الحساب الأول التي تنشئها البذرة النظيفة (php artisan migrate --seed)
# غيّرها قبل أي نشر حقيقي
SEED_SUPER_EMAIL=super@abadpos.com
SEED_SUPER_PASSWORD=password
SEED_ADMIN_EMAIL=admin@abadpos.com
SEED_ADMIN_PASSWORD=password
SEED_OWNER_NAME="مالك النشاط"
SEED_BUSINESS_NAME="متجري"

# واتساب — تكامل ميتا (WhatsApp Cloud API)
# الرقم المشترك يربطه مدير المنصّة من شاشة الإعدادات؛ هذه اعتمادات التطبيق وحده.
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v26.0

# التسجيل المدمج (Embedded Signup) — معرّف إعداد التسجيل من لوحة ميتا.
# ليس سرًّا: يصل المتصفّح لأنّ نافذة ميتا تطلبه. والسرُّ هو
# META_WHATSAPP_APP_SECRET وحده، ولا يمرّ بالشاشة قطّ.
#
# وأسماءٌ بديلة تُقبل لمن كتبها بها: META_APP_ID و META_APP_SECRET
# و META_GRAPH_API_VERSION و META_WHATSAPP_WEBHOOK_VERIFY_TOKEN
# و META_WHATSAPP_EMBEDDED_CONFIG_ID — والأسماءُ أعلاه هي الأولى.
#
# ورمزُ الوصول يُشفَّر بمفتاح التطبيق (APP_KEY) عبر `encrypted` cast —
# فلا مفتاحَ تشفيرٍ ثانٍ يُضاف هنا ولا يُعاد تشفيرُ ما هو قائم.
