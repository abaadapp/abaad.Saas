# =====================================================================
#  أبعاد — قالب إعدادات الإنتاج
#
#  انسخه إلى .env على الخادم ثم املأ القيم:  cp .env.production.example .env
#  بعد التعبئة تحقّق دائمًا بـ:              php artisan abaad:preflight
#
#  ما يلي ليس تفضيلات تجميلية: كل سطر مُعلَّم بـ(حرج) يفتح ثغرة إن أُهمل.
# =====================================================================

APP_NAME="Abaad"
# (حرج) local يُسجّل مسار الدخول التجريبي الذي يمنح جلسة مدير منصة بلا كلمة مرور
APP_ENV=production
# (حرج) توليده مرّة واحدة: php artisan key:generate
APP_KEY=
# (حرج) مفتوحًا يعرض أي خطأ مسارات الملفات ومحتوى .env للزائر
APP_DEBUG=false
# (حرج) تُبنى منه روابط الفواتير والبريد وإعادة التوجيه
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=Asia/Muscat

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --------------------------- قاعدة البيانات ---------------------------
# SQLite تكفي متجرًا واحدًا. لعدّة متاجر ومستخدمين متزامنين استخدم MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abaad
DB_USERNAME=
DB_PASSWORD=

# ------------------------------ الجلسات ------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
# (حرج) بدونه تنتقل كوكي الجلسة على http فتُلتقط على الشبكات المفتوحة
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------ الحذف النهائيّ للشركات (مغلقٌ افتراضيًّا) ------------------
# فعلٌ لا تراجعَ فيه: يمحو شركةً وكلَّ بياناتها ومستخدميها وملفّاتها. ولا
# يعمل حتّى تُفتح هذه المفاتيحُ صراحةً — وفتحُها قرارٌ لا خطوةُ نشر.
#
# ولا يبدأ الحذفُ إلّا بثلاثٍ معًا: المفتاحُ مفتوح، وقرصٌ مستقلٌّ عن هذا
# الخادم مهيَّأٌ ويُكتب عليه، وعاملُ طابورٍ يعمل. وما عدا ذلك يُردّ بكلمةٍ
# تُقرأ على الشاشة — ولا يُكتفى بالقرص المحلّيّ في صمت.
BUSINESS_PURGE_ENABLED=false

# مفتاحُ تشفير الأرشيف — ٣٢ بايتًا بـbase64، يُولَّد مرّةً:
#     php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# ويُحفظ نسخةٌ منه خارجَ الخادم وخارجَ المستودع: ضياعُه يعني أرشيفًا لا يُفكّ.
BUSINESS_PURGE_ARCHIVE_KEY=

# اسمُ القرص المستقلّ من config/filesystems.php — `spaces` للمهيَّأ هنا
BUSINESS_PURGE_OFFSITE_DISK=
BUSINESS_PURGE_OFFSITE_PREFIX=business-purges

# DigitalOcean Spaces — دلوٌ خاصٌّ لا عامّ، ومفتاحٌ لا يقرأ غيرَه إن أمكن
BUSINESS_PURGE_SPACES_KEY=
BUSINESS_PURGE_SPACES_SECRET=
BUSINESS_PURGE_SPACES_REGION=fra1
BUSINESS_PURGE_SPACES_BUCKET=
BUSINESS_PURGE_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# اتركه فارغًا: يُكشف عاملُ الطابور بـpgrep. ولا يُضبط إلّا على خادمٍ مُنع
# فيه shell_exec ويُعلم أنّ عاملَه يعمل.
# BUSINESS_PURGE_ASSUME_WORKER=

# ------------------------------- البريد -------------------------------
# بدون إعداد صحيح تفشل التنبيهات والتقارير الشهرية بصمت — بلا رسالة خطأ
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------- بذرة أول تشغيل ----------------------------
# تُقرأ مرّة واحدة عند php artisan migrate --seed لإنشاء أول حسابين.
# (حرج) غيّرها قبل التشغيل — القيم الافتراضية معروفة للجميع،
# وفحص preflight يرفض الإطلاق إن بقيت.
SEED_SUPER_EMAIL=
SEED_SUPER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_NAME=
SEED_BUSINESS_NAME=

VITE_APP_NAME="${APP_NAME}"
