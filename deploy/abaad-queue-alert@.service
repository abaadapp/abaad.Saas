# تنبيهٌ عند سقوط عاملِ الطابور — يشغّله `OnFailure=` من الوحدة الساقطة
#
# التثبيت — ومعه `abaad-queue-alert.conf` الذي يربطها بالوحدة القائمة
# بلا أن يستبدلها. انظر `README.md`.
#
#     sudo cp /var/www/abaad/deploy/abaad-queue-alert@.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#
# ولا `enable` لها: لا تعمل من نفسها، بل تُشغَّل عند سقوطِ غيرها. و`%i`
# هو اسمُ الوحدة الساقطة، يُمرَّر إلى الأمر ليُقال في البريد.
#
# وللتجربة بلا انتظار سقوط:
#
#     sudo systemctl start 'abaad-queue-alert@abaad-queue.service'

[Unit]
Description=Abaad — تنبيه بسقوط %i

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/abaad
ExecStart=/usr/bin/php /var/www/abaad/artisan abaad:queue-alert %i
