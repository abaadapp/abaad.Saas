            "00000000",
            "00100000"
          ]
        ],
        "rows": [
          "10000000",
          "00000000",
          "00000000",
          "00100000"
        ],
        "note": "a wholly blank page in the middle is part of one seam gap: 5 -> 2"
      },
      {
        "name": "first-page-leading-blank-kept",
        "width": 8,
        "maxSeamBlank": 1,
        "pages": [
