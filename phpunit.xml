<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            المجموعة تمرّ على أكثر من مئة صفحة في عمليةٍ واحدة، وفيها ما يبني
            ملفّ xlsx في الذاكرة. و128M الافتراضية كانت تنفد عند اختبارٍ لا
            علاقة له بالسبب، فيبدو العطب في غير موضعه.
        -->
        <!--
            ألفُ ميغا لا خمسمئة: الحزمةُ كلُّها في عمليّةٍ واحدة (`php artisan test` في CI)،
            وكانت تبلغ ~٤٥٠ ميغا قبل أن تصل اختباراتِ ملفّات Excel وPDF — فيُسقطها أيُّ
            اختبارٍ يُضاف بخطأ ذاكرةٍ لا علاقةَ له بما يقيسه.
        -->
        <!--
            وألفان لا ألف (2026-11-28): بلغت الحزمةُ ~٨٠٠ ميغا بعد جمع المهملات
            قبل آخر اختباراتها، وبلا جمعٍ تتجاوز الألف — فسقطت وظيفةُ SQLite على
            #195 مرّتين عند اختبار الخمسين ألف طلب، وهو وحده لا يزيد ٣٠ ميغا.
            والسببُ ليس اختبارًا بعينه: اختبارٌ فارغ يُبقي ~٤١ ك.ب. كلَّ مرّة،
            ومنه أنّ PHP بلا OPcache تُبقي شيئًا من كلّ دالّةٍ مجهولة كلّما أعادت
            قراءة ملفّها (المسارات والقوالب تُقرأ في كلّ اختبار) — ~٤١ ك.ب. ×
            ~١٠٬٦٠٠ اختبار. السقفُ يحمي العمليّة ولا يقيس شيئًا: لا اختبارَ يُتخطّى.
        -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- حدودُ جولة الصور القديمة تقرأ حِملَ الجهاز نفسه، وجهازُ CI مشغولٌ بالاختبارات: تُفتح وتُحاكى في AnOldImageWaitsForAQuietServerTest -->
        <env name="IMAGES_BATCH_GATE" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
